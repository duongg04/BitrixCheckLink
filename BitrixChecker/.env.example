# =====================================================================
# BitrixChecker environment template
# Copy to .env and fill in REAL values. Required values are left EMPTY
# on purpose so the system fails fast with a clear message instead of
# starting with a publicly-known credential:
#   - docker compose refuses to start while MYSQL_ROOT_PASSWORD is empty.
#   - The backend refuses to start while Jwt:Key is missing or < 32 chars.
#   - Admin seeding is skipped unless the FULL admin triple is provided.
# NEVER commit the real .env to source control.
# =====================================================================

# MySQL root password (REQUIRED) - use a long, unique password
MYSQL_ROOT_PASSWORD=
# Database name (optional)
MYSQL_DATABASE=bitrix_checker

# JWT signing key (REQUIRED) - at least 32 random characters
# Generate one with:  openssl rand -base64 48
JWT_KEY=
JWT_ISSUER=BitrixChecker
JWT_AUDIENCE=BitrixCheckerUsers
JWT_EXPIRY_MINUTES=60

# Seed admin account - all three values are required for seeding to run
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@bitrix24.vn
SEED_ADMIN_PASSWORD=
